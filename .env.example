# Upstash Redis Credentials for Global Multiplayer Leaderboard
# 1. Create a free Redis database at https://console.upstash.com
#    OR in Vercel: Project Dashboard -> Storage -> Create Database -> KV / Upstash Redis
# 2. Copy the REST URL and REST TOKEN into your Vercel Project Settings -> Environment Variables

UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
